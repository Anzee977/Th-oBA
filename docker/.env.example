# Copier ce fichier en .env sur le VPS (à côté de docker-compose.yml) et remplir.
# Ne JAMAIS committer le fichier .env réel.

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_db

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_admin

# Clé maître Meilisearch (recherche plein texte). Génération : openssl rand -base64 32
MEILI_MASTER_KEY=change_me_meili_key

# Mot de passe du compte MariaDB dédié à l'historique santé (Garmin), créé
# automatiquement au premier démarrage par docker/mariadb-init/init-health-db.sh.
HEALTH_DB_PASSWORD=change_me_health_db

# Optionnel : IP sur laquelle Caddy publie les ports 80/443 (par défaut 0.0.0.0, toutes
# interfaces). À renseigner si un autre service occupe déjà 80/443 sur une interface du VPS
# (ex: Tailscale Serve/Funnel) pour éviter un conflit "address already in use".
# CADDY_BIND_IP=1.2.3.4
