# Copier en .env (à côté de ce fichier) sur le VPS. Ne jamais committer le .env réel.

# Mot de passe unique pour accéder au site (toi seul)
SITE_PASSWORD=change_me

# Clé de session : chaîne aléatoire d'au moins 32 caractères.
# Génération : openssl rand -base64 32
SESSION_SECRET=change_me_at_least_32_characters_long

# Connexion à Nextcloud (WebDAV)
NEXTCLOUD_URL=https://cloud.anzee.xyz
NEXTCLOUD_USERNAME=admin
# Ne jamais utiliser le mot de passe du compte : créer un "app password" dédié
# dans Nextcloud > Paramètres > Sécurité > Créer un nouveau mot de passe d'application.
NEXTCLOUD_APP_PASSWORD=change_me

# Dossier racine dans Nextcloud où seront créés les dossiers de cours
NEXTCLOUD_BASE_FOLDER=Cours

# Recherche plein texte (Meilisearch, service "meilisearch" du docker-compose).
# Même valeur que MEILI_MASTER_KEY dans docker/.env. Laisser vide pour désactiver la recherche.
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_KEY=change_me_meili_key

# Page Santé (données Garmin Connect). Compte sans double authentification (2FA) requis :
# la librairie utilisée ne gère pas le MFA. Laisser vide pour désactiver la page.
GARMIN_EMAIL=change_me@example.com
GARMIN_PASSWORD=change_me

# Historique santé (base MariaDB dédiée, service "db" du docker-compose).
# Même mot de passe que HEALTH_DB_PASSWORD dans docker/.env. Laisser vide pour désactiver
# le stockage historique (la page Santé retombe sur des données live non persistées).
HEALTH_DB_HOST=db
HEALTH_DB_NAME=health
HEALTH_DB_USER=health_app
HEALTH_DB_PASSWORD=change_me_health_db

# Génération de synthèse IA (bouton "Générer ma synthèse" dans un cours).
# Clé API créée sur console.anthropic.com > API Keys. Laisser vide pour désactiver la fonction.
ANTHROPIC_API_KEY=change_me

# Notifications push (Web Push). Générer une paire avec :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Laisser vide pour désactiver les notifications.
VAPID_PUBLIC_KEY=change_me
VAPID_PRIVATE_KEY=change_me
VAPID_SUBJECT=mailto:change_me@example.com

# Poids (en kg), utilisé uniquement pour estimer les calories des activités sportives
# ajoutées manuellement quand aucune activité Garmin correspondante n'est trouvée
# (formule MET × poids × durée). Par défaut 75 si absent.
BODY_WEIGHT_KG=75
