# Copier en .env (à côté de ce fichier) sur le VPS. Ne jamais committer le .env réel.

# Mot de passe unique pour accéder au site (toi seul)
SITE_PASSWORD=change_me

# Clé de session : chaîne aléatoire d'au moins 32 caractères.
# Génération : openssl rand -base64 32
SESSION_SECRET=change_me_at_least_32_characters_long

# Connexion à Nextcloud (WebDAV)
NEXTCLOUD_URL=https://cloud.anzee.xyz
NEXTCLOUD_USERNAME=admin
# Ne jamais utiliser le mot de passe du compte : créer un "app password" dédié
# dans Nextcloud > Paramètres > Sécurité > Créer un nouveau mot de passe d'application.
NEXTCLOUD_APP_PASSWORD=change_me

# Dossier racine dans Nextcloud où seront créés les dossiers de cours
NEXTCLOUD_BASE_FOLDER=Cours
